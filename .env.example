# Copy to .env and fill in what you need. Everything except the web app settings is optional.

# --- AI (Claude) -----------------------------------------------------------------------------
# Enables fit analysis, resume parsing, cover letters and the apply agent.
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# --- Optional job-search APIs --------------------------------------------------------------
# Adzuna (free): https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# JSearch on RapidAPI (free tier): https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
JSEARCH_API_KEY=

# --- Web app ------------------------------------------------------------------------------
JOBBOT_HOST=127.0.0.1
JOBBOT_PORT=8000
# Where the database, your resume and screenshots are stored.
JOBBOT_DATA_DIR=data
# Require a password for the web UI. Strongly recommended if anyone else can reach it.
# JOBBOT_PASSWORD=
# Extra hostnames/IPs allowed to reach the UI (comma separated), e.g. a LAN IP or domain.
# JOBBOT_ALLOWED_HOSTS=192.168.1.20,jobs.example.com
# Public URL of the UI, used for links in notifications.
# JOBBOT_BASE_URL=http://localhost:8000
# Use your own Chrome/Chromium for the apply agent instead of Playwright's.
# JOBBOT_CHROMIUM_PATH=/usr/bin/google-chrome
# JOBBOT_LOG_LEVEL=INFO
